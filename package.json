{
  "name": "scmcu-vscode",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.9.10",
  "publisher": "local",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/YoussefMostafaMohammed/SCMCU_IDE-VSCODE-Plugin.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "SC8F052",
    "SC8F072",
    "SCMCU",
    "picc",
    "scx"
  ],
  "activationEvents": [
    "workspaceContains:**/*.scw",
    "workspaceContains:**/*.{c,asm,s}",
    "onCommand:scmcu.build",
    "onCommand:scmcu.buildAndFlash",
    "onCommand:scmcu.flash",
    "onCommand:scmcu.selectChip",
    "onCommand:scmcu.hardwareOptions",
    "onCommand:scmcu.configureCompiler",
    "onCommand:scmcu.detectCompiler",
    "onCommand:scmcu.manageSources",
    "onCommand:scmcu.setDevice",
    "onCommand:scmcu.setConfigWords"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "scmcu.build",
        "title": "%command.build.title%",
        "icon": "$(debug-start)"
      },
      {
        "command": "scmcu.buildAndFlash",
        "title": "%command.buildAndFlash.title%",
        "icon": "$(zap)"
      },
      {
        "command": "scmcu.flash",
        "title": "%command.flash.title%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "scmcu.hardwareOptions",
        "title": "%command.hardwareOptions.title%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "scmcu.selectChip",
        "title": "%command.selectChip.title%"
      },
      {
        "command": "scmcu.configureCompiler",
        "title": "%command.configureCompiler.title%"
      },
      {
        "command": "scmcu.detectCompiler",
        "title": "%command.detectCompiler.title%"
      },
      {
        "command": "scmcu.manageSources",
        "title": "%command.manageSources.title%",
        "icon": "$(file-directory)"
      },
      {
        "command": "scmcu.setDevice",
        "title": "%command.setDevice.title%"
      },
      {
        "command": "scmcu.setConfigWords",
        "title": "%command.setConfigWords.title%"
      },
      {
        "command": "scmcu.startup",
        "title": "%command.startup.title%"
      },
      {
        "command": "scmcu.fixConfigWords",
        "title": "%command.fixConfigWords.title%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "scmcu.build",
          "when": "resourceFilename =~ /\\.scw$/ || workspaceContains:**/*.scw",
          "group": "SCMCU@1"
        },
        {
          "command": "scmcu.hardwareOptions",
          "when": "resourceFilename =~ /\\.scw$/",
          "group": "SCMCU@2"
        }
      ],
      "commandPalette": [
        {
          "command": "scmcu.build"
        },
        {
          "command": "scmcu.hardwareOptions",
          "when": "workspaceContains:**/*.scw"
        },
        {
          "command": "scmcu.selectChip",
          "when": "workspaceContains:**/*.scw"
        },
        {
          "command": "scmcu.manageSources",
          "when": "workspaceContains:**/*.scw"
        },
        {
          "command": "scmcu.setDevice"
        },
        {
          "command": "scmcu.setConfigWords"
        },
        {
          "command": "scmcu.startup"
        },
        {
          "command": "scmcu.fixConfigWords"
        },
        {
          "command": "scmcu.buildAndFlash"
        },
        {
          "command": "scmcu.flash"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "scmcu.compilerPath": {
          "type": "string",
          "default": "",
          "description": "%configuration.compilerPath.description%"
        },
        "scmcu.idePath": {
          "type": "string",
          "default": "",
          "description": "%configuration.idePath.description%"
        },
        "scmcu.buildDir": {
          "type": "string",
          "default": "build",
          "description": "%configuration.buildDir.description%"
        },
        "scmcu.outputName": {
          "type": "string",
          "default": "SCMCU_Project",
          "description": "%configuration.outputName.description%"
        },
        "scmcu.sourceDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "src"
          ],
          "description": "%configuration.sourceDirs.description%"
        },
        "scmcu.includeDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "inc"
          ],
          "description": "%configuration.includeDirs.description%"
        },
        "scmcu.device": {
          "type": "string",
          "default": "",
          "description": "%configuration.device.description%"
        },
        "scmcu.configWords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%configuration.configWords.description%"
        },
        "scmcu.sourceFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%configuration.sourceFiles.description%"
        },
        "scmcu.noScwBehavior": {
          "type": "string",
          "enum": [
            "prompt",
            "load",
            "skip"
          ],
          "default": "prompt",
          "enumDescriptions": [
            "%configuration.noScwBehavior.prompt%",
            "%configuration.noScwBehavior.load%",
            "%configuration.noScwBehavior.skip%"
          ],
          "description": "%configuration.noScwBehavior.description%"
        },
        "scmcu.writerPath": {
          "type": "string",
          "default": "",
          "description": "%configuration.writerPath.description%"
        },
        "scmcu.flashCount": {
          "type": "number",
          "default": 0,
          "description": "%configuration.flashCount.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node test/configWords.regression.js && node test/programmer.regression.js",
    "package": "npm run build:helper && vsce package --allow-missing-repository",
    "build:helper": "python flash/build_helper.py"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.9.3"
  }
}
